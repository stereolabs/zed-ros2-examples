<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>zed_isaac_ros_object_detection</name>
    <version>5.6.0</version>
    <description>Contains an example to detect objects in the ZED camera images with the Isaac ROS 5 RT-DETR and YOLOv8 object detection packages, using the CUDA zero-copy transport of ROS 2 Lyrical (rosidl::Buffer).</description>
    <maintainer email="support@stereolabs.com">STEREOLABS</maintainer>
    <license>Apache License 2.0</license>
    <url type="website">https://www.stereolabs.com/</url>
    <url type="repository">https://github.com/stereolabs/zed-ros2-examples</url>
    <url type="bugtracker">https://github.com/stereolabs/zed-ros2-examples/issues</url>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <exec_depend>zed_wrapper</exec_depend>
    <exec_depend>zed_components</exec_depend>
    <exec_depend>launch_ros</exec_depend>
    <exec_depend>rclcpp_components</exec_depend>
    <exec_depend>rclpy</exec_depend>
    <exec_depend>sensor_msgs</exec_depend>
    <exec_depend>vision_msgs</exec_depend>
    <exec_depend>foxglove_msgs</exec_depend>
    <exec_depend condition="$ROS_DISTRO >= lyrical">isaac_ros_image_proc</exec_depend>
    <exec_depend condition="$ROS_DISTRO >= lyrical">isaac_ros_tensor_proc</exec_depend>
    <exec_depend condition="$ROS_DISTRO >= lyrical">isaac_ros_tensor_rt</exec_depend>
    <exec_depend condition="$ROS_DISTRO >= lyrical">isaac_ros_rtdetr</exec_depend>
    <exec_depend condition="$ROS_DISTRO >= lyrical">isaac_ros_yolov8</exec_depend>

    <test_depend>ament_lint_auto</test_depend>
    <test_depend>ament_lint_common</test_depend>
    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
