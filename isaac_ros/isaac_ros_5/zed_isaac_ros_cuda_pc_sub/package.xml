<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>zed_isaac_ros_cuda_pc_sub</name>
    <version>5.6.0</version>
    <description>Contains an example to subscribe to the ZED point cloud using the CUDA zero-copy transport of ROS 2 Lyrical (rosidl::Buffer), print the coordinates of its middle point, and display communication benchmarks.</description>
    <maintainer email="support@stereolabs.com">STEREOLABS</maintainer>
    <license>Apache License 2.0</license>
    <url type="website">https://www.stereolabs.com/</url>
    <url type="repository">https://github.com/stereolabs/zed-ros2-examples</url>
    <url type="bugtracker">https://github.com/stereolabs/zed-ros2-examples/issues</url>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <build_depend>ament_cmake_auto</build_depend>

    <depend>rclcpp</depend>
    <depend>rclcpp_components</depend>
    <depend>rcutils</depend>
    <depend>sensor_msgs</depend>
    <depend condition="$ROS_DISTRO >= lyrical">cuda_buffer</depend>
    <depend condition="$ROS_DISTRO >= lyrical">rosidl_buffer_backend_registry</depend>
    <depend>zed_components</depend>

    <exec_depend>launch_ros</exec_depend>

    <test_depend>ament_lint_auto</test_depend>
    <test_depend>ament_lint_common</test_depend>
    <test_depend>ament_cmake_clang_format</test_depend>
    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
