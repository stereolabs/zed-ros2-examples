<?xml version="1.0"?>
<!-- Package format 3 according to http://www.ros.org/reps/rep-0149.html -->
<package format="3">
    <name>zed_topic_benchmark_component</name>
    <version>5.4.1</version>
    <description> This package contains tools to test the performance of the ZED ROS2 Wrapper </description>
    <maintainer email="support@stereolabs.com">STEREOLABS</maintainer>
    <license>Apache License 2.0</license>
    <url type="website">https://www.stereolabs.com/</url>
    <url type="repository">https://github.com/stereolabs/zed-ros2-wrapper</url>
    <url type="bugtracker">https://github.com/stereolabs/zed-ros2-wrapper/issues</url>

    <buildtool_depend>ament_cmake</buildtool_depend>

    <build_depend>ament_cmake_auto</build_depend>
    <depend>zed_topic_benchmark_interfaces</depend>
    <depend>rclcpp</depend>
    <depend>rclcpp_components</depend>
    <depend>sensor_msgs</depend>

    <!-- Optional: enables the ZED type-adapted (zero-copy) subscription path.
         The benchmark builds and works without it, but cannot report true
         zero-copy delivery. -->
    <build_depend>zed_components</build_depend>
    <exec_depend>zed_components</exec_depend>

    <!-- Optional: typed support for the non-sensor_msgs transports of
         image_transport and point_cloud_transport. Each is used only if
         present at build time; without it those topics fall back to the
         generic subscription. sensor_msgs/CompressedImage already covers the
         compressed, compressedDepth and zstd image transports. -->
    <build_depend>theora_image_transport</build_depend>
    <build_depend>point_cloud_interfaces</build_depend>

    <test_depend>ament_lint_auto</test_depend>
    <test_depend>ament_lint_common</test_depend>
    <test_depend>ament_cmake_clang_format</test_depend>
    <test_depend>ament_cmake_gtest</test_depend>

    <export>
        <build_type>ament_cmake</build_type>
    </export>
</package>
